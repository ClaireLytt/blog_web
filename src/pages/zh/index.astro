---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalCard from '../../components/TerminalCard.astro';
import ConductorGate from '../../components/ConductorGate.astro';

const posts = (await getCollection('blog', ({ id }) => id.startsWith('zh/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Yantong Li — 技术博客" lang="zh">
  <ConductorGate lang="zh" slot="gate" />
  <section class="hero">
    <p class="hero-eyebrow">Code · Open Source · Notes</p>
    <h1>你好，我是 <span class="shimmer">Yantong Li</span>！</h1>
    <p class="hero-typing"><span id="typing"></span><span class="cursor"></span></p>
    <hr class="hero-rule" />
    <p class="hero-desc">
      欢迎来到我的小站。我在这里记录编程、开源，以及一路学到的东西。
    </p>
    <a href="/zh/blog" class="btn btn-primary">阅读博客<span class="btn-arrow">›</span></a>
    <a href="/zh/about" class="btn btn-ghost">关于我</a>
  </section>

  <section class="section">
    <TerminalCard
      lines={[
        { cmd: 'whoami', out: ['Yantong Li — 开发者，**Apache ShardingSphere** Committer'] },
        { cmd: 'cat interests.txt', out: ['java · 分布式系统 · 开源 · 数据库'] },
        { cmd: 'echo $MOTTO', out: ['"理解一件事最好的方式，是把它讲明白。"'] },
      ]}
    />
  </section>

  <section class="section">
    <h2 class="section-title">最新文章</h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li class="fade-in">
          <a href={`/zh/blog/${post.id.slice(3)}`} class="post-card">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-meta">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>
    const phrases = [
      '我用代码构建世界。',
      '我为开源社区做贡献。',
      '我写下学到的一切。',
    ];
    const el = document.getElementById('typing')!;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = phrases[0]!;
    } else {
      let phraseIndex = 0;
      let charIndex = 0;
      let deleting = false;

      const tick = () => {
        const phrase = phrases[phraseIndex]!;
        if (!deleting) {
          charIndex++;
          el.textContent = phrase.slice(0, charIndex);
          if (charIndex === phrase.length) {
            deleting = true;
            setTimeout(tick, 1800);
            return;
          }
          setTimeout(tick, 120);
        } else {
          charIndex--;
          el.textContent = phrase.slice(0, charIndex);
          if (charIndex === 0) {
            deleting = false;
            phraseIndex = (phraseIndex + 1) % phrases.length;
          }
          setTimeout(tick, 50);
        }
      };
      tick();
    }
  </script>
</BaseLayout>
