---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ id }) => id.startsWith('zh/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="博客 — Yantong Li" description="所有关于编程与技术的文章。" lang="zh">
  <header class="page-header">
    <h1>博客<span class="gradient-text">。</span></h1>
    <p class="mono">共 {posts.length} 篇文章</p>
  </header>

  <section class="section">
    <ul class="post-list">
      {posts.map((post) => (
        <li class="fade-in">
          <a href={`/zh/blog/${post.id.slice(3)}`} class="post-card">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-meta">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
