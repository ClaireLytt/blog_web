---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const words = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BaseLayout title={`${post.data.title} — claire.dev`} description={post.data.description}>
  <article>
    <header class="article-header">
      <div class="post-meta">
        <span>{formatDate(post.data.pubDate)}</span>
        <span>·</span>
        <span>{readingTime} min read</span>
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <p style="color: var(--color-text-muted);">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <p style="margin-top: 3rem;">
      <a href="/blog" class="mono">&larr; back to all posts</a>
    </p>
  </article>
</BaseLayout>
