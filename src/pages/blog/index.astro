---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog — claire.dev" description="All articles on programming and technology.">
  <header class="page-header">
    <h1>Blog<span class="gradient-text">.</span></h1>
    <p class="mono">{posts.length} {posts.length === 1 ? 'post' : 'posts'} and counting</p>
  </header>

  <section class="section">
    <ul class="post-list">
      {posts.map((post) => (
        <li class="fade-in">
          <a href={`/blog/${post.id}`} class="post-card">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-meta">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
