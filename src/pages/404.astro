---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" lang="en" hasTranslation={false} switchUrl="/zh">
  <section class="hero" style="text-align: center;">
    <p class="mono" style="font-size: 5rem; font-weight: 700; color: var(--color-accent); line-height: 1;">
      404
    </p>
    <h1 style="font-size: clamp(1.5rem, 4vw, 2rem); margin-top: 1rem;">Page not found</h1>
    <p class="hero-desc" style="margin: 1rem auto 0.25rem;">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <p class="hero-desc" style="margin: 0 auto 2rem;" lang="zh-CN">
      你要找的页面不存在，或者已经被移动了。
    </p>
    <a href="/" class="btn btn-primary">Back to Home</a>
    <a href="/blog" class="btn btn-ghost">Browse Posts</a>
  </section>
</BaseLayout>
