---
/**
 * Entry game — "The Conductor".
 * Hold the mouse and wave: Y controls pitch (quantized to a pentatonic
 * scale so anything you play sounds good), X controls brightness
 * (low-pass filter cutoff). A row of spectrum bars at the bottom
 * dances to the real AnalyserNode data. Sweep the cursor through the
 * three hollow notes on the staff to light them; then your own
 * recording plays back as the overture, and the blog fades in.
 * No audio files — everything is synthesized with Web Audio.
 * Skippable (× / Esc); shows on every load; never on touch devices or
 * under prefers-reduced-motion; automated browsers skip unless ?game=1.
 */
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;
const t =
  lang === 'zh'
    ? {
        hint: '按住，挥动，即是演奏。',
        sub: '点亮谱线上的三个音符',
        count: '音符',
        overture: '你的序曲 —',
        scroll: '向下滑动',
      }
    : {
        hint: 'hold and wave. that is playing.',
        sub: 'light the three notes on the staff',
        count: 'notes',
        overture: 'your overture —',
        scroll: 'scroll down',
      };
---
<div class="con-gate" id="con-gate" data-i18n={JSON.stringify(t)}>
  <canvas class="con-bars" aria-hidden="true"></canvas>
  <div class="con-staff" aria-hidden="true">
    <span class="con-note" style="left: 28%"></span>
    <span class="con-note" style="left: 50%"></span>
    <span class="con-note" style="left: 72%"></span>
  </div>
  <div class="con-dot" aria-hidden="true"></div>
  <p class="con-hint mono">
    {t.hint}
    <span class="con-sub">{t.sub}</span>
  </p>
  <p class="con-word mono" aria-live="polite"></p>
  <span class="con-count mono">0/3 {t.count}</span>
  <button class="con-mute mono" aria-label="mute">♪</button>
  <button class="con-close mono" aria-label="skip">×</button>
</div>
<script>
  const gate = document.getElementById('con-gate');
  const skip =
    !gate ||
    // test escape hatch: automated browsers skip the gate unless a test
    // opts in with ?game=1 — real visitors are never affected
    (navigator.webdriver && !location.search.includes('game=1')) ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    window.matchMedia('(pointer: coarse)').matches;
  if (skip) {
    gate?.remove();
  } else {
    const t = JSON.parse(gate.dataset.i18n!);
    const dot = gate.querySelector<HTMLElement>('.con-dot')!;
    const word = gate.querySelector<HTMLElement>('.con-word')!;
    const countEl = gate.querySelector<HTMLElement>('.con-count')!;
    const notes = [...gate.querySelectorAll<HTMLElement>('.con-note')];
    const muteBtn = gate.querySelector<HTMLElement>('.con-mute')!;
    const canvas = gate.querySelector<HTMLCanvasElement>('.con-bars')!;
    const ctx = canvas.getContext('2d')!;
    document.body.style.overflow = 'hidden';
    canvas.width = window.innerWidth;
    canvas.height = 160;
    // ---- synth: saw lead + sub sine → lowpass → gain → analyser → out
    let ac: AudioContext | null = null;
    let osc: OscillatorNode, sub: OscillatorNode, filt: BiquadFilterNode;
    let gain: GainNode, master: GainNode, analyser: AnalyserNode | null = null;
    let muted = false;
    const ensureAudio = () => {
      if (ac) {
        ac.resume();
        return;
      }
      try {
        ac = new AudioContext();
        osc = ac.createOscillator();
        osc.type = 'sawtooth';
        sub = ac.createOscillator();
        sub.type = 'sine';
        filt = ac.createBiquadFilter();
        filt.type = 'lowpass';
        filt.Q.value = 5;
        gain = ac.createGain();
        gain.gain.value = 0;
        master = ac.createGain();
        master.gain.value = muted ? 0 : 1;
        analyser = ac.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.82;
        osc.connect(filt);
        sub.connect(filt);
        filt.connect(gain);
        gain.connect(analyser);
        analyser.connect(master);
        master.connect(ac.destination);
        osc.start();
        sub.start();
      } catch {
        ac = null; // no audio? the game still works silently
      }
    };
    // C-major pentatonic across two octaves: wave anywhere, it sounds fine
    const PENT = [60, 62, 64, 67, 69, 72, 74, 76, 79, 81, 84];
    const midiHz = (m: number) => 440 * Math.pow(2, (m - 69) / 12);
    const setVoice = (x: number, y: number) => {
      if (!ac) return;
      const yr = 1 - Math.min(Math.max(y / window.innerHeight, 0), 1);
      const midi = PENT[Math.min(Math.floor(yr * PENT.length), PENT.length - 1)]!;
      const f = midiHz(midi);
      const now = ac.currentTime;
      osc.frequency.setTargetAtTime(f, now, 0.03); // light portamento
      sub.frequency.setTargetAtTime(f / 2, now, 0.03);
      const cutoff = 300 * Math.pow(16, Math.min(Math.max(x / window.innerWidth, 0), 1));
      filt.frequency.setTargetAtTime(cutoff, now, 0.05);
      return { f, cutoff };
    };
    const voiceOn = () => ac && gain.gain.setTargetAtTime(0.14, ac.currentTime, 0.04);
    const voiceOff = () => ac && gain.gain.setTargetAtTime(0, ac.currentTime, 0.08);
    // confirmation sparkle when a note lights up: a short sine arpeggio tone
    const blip = (midi: number) => {
      if (!ac || !analyser) return;
      const o = ac.createOscillator();
      const g = ac.createGain();
      o.type = 'sine';
      o.frequency.value = midiHz(midi);
      g.gain.setValueAtTime(0.22, ac.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.5);
      o.connect(g);
      g.connect(analyser);
      o.start();
      o.stop(ac.currentTime + 0.55);
    };
    // ---- game state
    let playing = false;
    let finale = false;
    let lit = 0;
    const rec: { dt: number; f: number; c: number; off?: boolean }[] = [];
    let recStart = 0;
    // ---- spectrum bars (idle shimmer before audio exists)
    const BARS = 24;
    const freqData = new Uint8Array(128);
    const draw = (now: number) => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const bw = canvas.width / BARS;
      for (let i = 0; i < BARS; i++) {
        let h = 2;
        if (analyser) {
          analyser.getByteFrequencyData(freqData);
          const bin = Math.floor((i / BARS) * 72); // keep to the audible bins
          h = 2 + (freqData[bin]! / 255) * (canvas.height - 10);
        } else {
          h = 2 + Math.abs(Math.sin(now / 900 + i * 0.6)) * 4; // idle breath
        }
        const x = i * bw + bw * 0.25;
        ctx.fillStyle = `rgba(37, 99, 235, ${0.25 + (h / canvas.height) * 0.6})`;
        ctx.beginPath();
        ctx.roundRect(x, canvas.height - h, bw * 0.5, h, 2);
        ctx.fill();
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
    // ---- pointer = baton
    const moveDot = (x: number, y: number) => {
      dot.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
    };
    gate.addEventListener('pointerdown', (e) => {
      if (finale) return;
      if ((e.target as HTMLElement).closest('.con-close, .con-mute')) return;
      ensureAudio();
      playing = true;
      dot.classList.add('con-dot-on');
      if (rec.length === 0) recStart = performance.now();
      const v = setVoice(e.clientX, e.clientY);
      voiceOn();
      if (v) rec.push({ dt: performance.now() - recStart, f: v.f, c: v.cutoff });
      moveDot(e.clientX, e.clientY);
      checkNotes(e.clientX, e.clientY);
    });
    gate.addEventListener('pointermove', (e) => {
      moveDot(e.clientX, e.clientY);
      if (!playing || finale) return;
      const v = setVoice(e.clientX, e.clientY);
      if (v) rec.push({ dt: performance.now() - recStart, f: v.f, c: v.cutoff });
      checkNotes(e.clientX, e.clientY);
    });
    const stopPlaying = () => {
      if (!playing) return;
      playing = false;
      dot.classList.remove('con-dot-on');
      voiceOff();
      if (rec.length > 0) rec.push({ dt: performance.now() - recStart, f: 0, c: 0, off: true });
    };
    gate.addEventListener('pointerup', stopPlaying);
    gate.addEventListener('pointerleave', stopPlaying);
    // ---- the three notes: sweep through them while playing
    const CHORD = [72, 76, 79]; // C5 E5 G5 — lighting all three spells the chord
    function checkNotes(x: number, y: number) {
      notes.forEach((n, i) => {
        if (n.classList.contains('lit')) return;
        const r = n.getBoundingClientRect();
        const d = Math.hypot(x - (r.left + r.width / 2), y - (r.top + r.height / 2));
        if (d < 30) {
          n.classList.add('lit');
          blip(CHORD[i]!);
          lit++;
          countEl.textContent = `${lit}/3 ${t.count}`;
          if (lit === 3) beginFinale();
        }
      });
    }
    // ---- finale: your own recording plays back, then the blog
    const dismiss = () => {
      document.body.style.overflow = '';
      gate.classList.add('con-gate-out');
      setTimeout(() => {
        try {
          ac?.close();
        } catch {}
        gate.remove();
      }, 700);
    };
    function beginFinale() {
      finale = true;
      stopPlaying();
      word.textContent = t.overture;
      word.classList.add('con-word-in');
      const REPLAY_MS = Math.min(rec.length ? rec[rec.length - 1]!.dt : 0, 3200);
      const begin = performance.now();
      let idx = 0;
      const step = (now: number) => {
        const el = now - begin;
        if (el >= REPLAY_MS || !ac) {
          voiceOff();
          word.textContent = `▼ ${t.scroll}`;
          setTimeout(dismiss, 1000);
          return;
        }
        while (idx < rec.length && rec[idx]!.dt <= el) {
          const s = rec[idx]!;
          if (s.off) voiceOff();
          else {
            const nowA = ac.currentTime;
            osc.frequency.setTargetAtTime(s.f, nowA, 0.03);
            sub.frequency.setTargetAtTime(s.f / 2, nowA, 0.03);
            filt.frequency.setTargetAtTime(s.c, nowA, 0.05);
            voiceOn();
          }
          idx++;
        }
        requestAnimationFrame(step);
      };
      if (ac) setTimeout(() => requestAnimationFrame(step), 450);
      else {
        // silent environment: skip straight to the reveal
        word.textContent = `▼ ${t.scroll}`;
        setTimeout(dismiss, 1000);
      }
    }
    // ---- controls
    muteBtn.addEventListener('click', () => {
      muted = !muted;
      muteBtn.textContent = muted ? '∅' : '♪';
      muteBtn.classList.toggle('con-muted', muted);
      if (ac && master) master.gain.value = muted ? 0 : 1;
    });
    gate.querySelector('.con-close')!.addEventListener('click', () => dismiss());
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && gate.isConnected) dismiss();
    });
  }
</script>
