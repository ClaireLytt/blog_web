---
/**
 * Zen entry game — "one shot."
 * A breathing glass orb floats in the same white space as the blog.
 * One bullet: hit it (ideally at the top of its breath) and it bursts
 * into droplets; then the overlay fades and the blog is right there.
 * Skippable (× / Esc), remembered per session, and never shown on
 * touch devices or under prefers-reduced-motion.
 */
interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;

const t =
  lang === 'zh'
    ? { hint: '一息，一靶。', sub: '在它呼吸最满的时候', perfect: '完美。', ok: '破了。', miss: '再来。', scroll: '向下滑动' }
    : { hint: 'one shot.', sub: 'strike when it breathes fullest', perfect: 'perfect.', ok: 'done.', miss: 'again.', scroll: 'scroll down' };
---

<div class="zen-gate" id="zen-gate" data-i18n={JSON.stringify(t)}>
  <canvas class="zen-canvas" aria-hidden="true"></canvas>
  <div class="zen-orb" aria-hidden="true"></div>
  <div class="zen-ring" aria-hidden="true"></div>
  <p class="zen-hint mono">
    {t.hint}
    <span class="zen-sub">{t.sub}</span>
  </p>
  <p class="zen-word mono" aria-live="polite"></p>
  <button class="zen-close" aria-label="skip">×</button>
</div>

<script>
  const gate = document.getElementById('zen-gate');

  const skip =
    !gate ||
    sessionStorage.getItem('zen-gate') === 'done' ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    window.matchMedia('(pointer: coarse)').matches;

  if (skip) {
    gate?.remove();
  } else {
    const t = JSON.parse(gate.dataset.i18n!);
    const orb = gate.querySelector<HTMLElement>('.zen-orb')!;
    const ring = gate.querySelector<HTMLElement>('.zen-ring')!;
    const word = gate.querySelector<HTMLElement>('.zen-word')!;
    const canvas = gate.querySelector<HTMLCanvasElement>('.zen-canvas')!;
    const ctx = canvas.getContext('2d')!;

    document.body.style.overflow = 'hidden';
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    // ---- breathing, driven in JS so we know the exact phase
    let phase = 0;
    let alive = true;
    let start = performance.now();
    let mx = window.innerWidth / 2;
    let my = window.innerHeight * 0.75;

    const breathe = (now: number) => {
      phase = Math.sin((now - start) / 1400); // full breath ≈ 8.8s
      if (alive) {
        orb.style.transform = `translate(-50%, -50%) scale(${1 + 0.14 * phase})`;
        orb.style.opacity = String(0.85 + 0.15 * phase);
      }
      ring.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%) scale(${1 + 0.14 * phase})`;
      requestAnimationFrame(breathe);
    };
    requestAnimationFrame(breathe);

    gate.addEventListener('pointermove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    });

    // ---- droplets
    const drops: { x: number; y: number; vx: number; vy: number; r: number; a: number; hue: string }[] = [];
    const burst = (x: number, y: number) => {
      for (let i = 0; i < 48; i++) {
        const ang = Math.random() * Math.PI * 2;
        const v = 1.5 + Math.random() * 5;
        drops.push({
          x,
          y,
          vx: Math.cos(ang) * v,
          vy: Math.sin(ang) * v - 2.5,
          r: 1.5 + Math.random() * 3.5,
          a: 1,
          hue: Math.random() < 0.5 ? '37, 99, 235' : '6, 182, 212',
        });
      }
      const tick = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let liveDrops = 0;
        for (const d of drops) {
          d.vy += 0.16;
          d.x += d.vx;
          d.y += d.vy;
          d.a -= 0.011;
          if (d.a <= 0) continue;
          liveDrops++;
          ctx.fillStyle = `rgba(${d.hue}, ${d.a * 0.8})`;
          ctx.beginPath();
          ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
          ctx.fill();
        }
        if (liveDrops > 0) requestAnimationFrame(tick);
      };
      tick();
    };

    // ---- dismiss
    const dismiss = () => {
      sessionStorage.setItem('zen-gate', 'done');
      document.body.style.overflow = '';
      gate.classList.add('zen-gate-out');
      setTimeout(() => gate.remove(), 700);
    };

    // ---- shooting
    gate.addEventListener('click', (e) => {
      if (!alive) return;
      if ((e.target as HTMLElement).closest('.zen-close')) return;
      const r = orb.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const hit = Math.hypot(e.clientX - cx, e.clientY - cy) <= r.width / 2 + 6;

      if (hit) {
        alive = false;
        word.textContent = phase > 0.82 ? t.perfect : t.ok;
        word.classList.add('zen-word-in');
        orb.style.opacity = '0';
        burst(cx, cy);
        setTimeout(() => {
          word.textContent = `▼ ${t.scroll}`;
          setTimeout(dismiss, 900);
        }, 1100);
      } else {
        word.textContent = t.miss;
        word.classList.add('zen-word-in');
        orb.classList.remove('zen-orb-wobble');
        void orb.offsetWidth; // restart the wobble animation
        orb.classList.add('zen-orb-wobble');
        setTimeout(() => word.classList.remove('zen-word-in'), 900);
      }
    });

    gate.querySelector('.zen-close')!.addEventListener('click', dismiss);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && gate.isConnected) dismiss();
    });
  }
</script>
